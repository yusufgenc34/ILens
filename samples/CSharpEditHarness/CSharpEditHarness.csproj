<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles a C#-edit skeleton natively with the browser compiler's options, to
       produce the merge test fixture. Never part of the shipped application. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../compiler/CompilerOptions.cs" />
    <!-- Inputs compiled by the harness, not part of it. -->
    <Compile Remove="*.edit.cs" />
  </ItemGroup>
</Project>
